{
  "version": 8,
  "glyphs": "https://vectortiles.geo.admin.ch/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "satellite": {
      "type": "raster",
      "tiles": [
        "https://wmts.geo.admin.ch/1.0.0/ch.swisstopo.swissimage/default/current/3857/{z}/{x}/{y}.jpeg"
      ],
      "tileSize": 256
    },
    "topo": {
      "type": "raster",
      "tiles": [
        "https://wmts.geo.admin.ch/1.0.0/ch.swisstopo.swissalti3d-reliefschattierung/default/current/3857/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 18
    },
    "trails": {
      "type": "vector",
      "tiles": [
        "https://trail.jouve.ch/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 8,
      "maxzoom": 15
    },
    "swissnames3d": {
      "type": "vector",
      "url": "https://vectortiles.geo.admin.ch/tiles/ch.swisstopo.base.vt/v1.0.0/tiles.json",
      "attribution": "© swisstopo"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ede8dd"
      }
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "satellite"
    },
    {
      "id": "topo",
      "type": "raster",
      "source": "topo",
      "layout": {
        "visibility": "none"
      }
    },
    {
      "id": "swisstlm3d-wanderwege",
      "type": "line",
      "source": "trails",
      "source-layer": "wanderwege",
      "paint": {
        "line-color": "#2196F3",
        "line-width": 2
      }
    },
    {
      "id": "veloland",
      "type": "line",
      "source": "trails",
      "source-layer": "veloland",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "line-color": "#2196F3",
        "line-width": 2
      }
    },
    {
      "id": "wanderland",
      "type": "line",
      "source": "trails",
      "source-layer": "wanderland",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "line-color": "#2196F3",
        "line-width": 2
      }
    },
    {
      "id": "mtbland",
      "type": "line",
      "source": "trails",
      "source-layer": "mtbland",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "line-color": "#2196F3",
        "line-width": 2
      }
    },
    {
      "id": "skitouren",
      "type": "line",
      "source": "trails",
      "source-layer": "skitouren",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "line-color": "#2196F3",
        "line-width": 2
      }
    },
    {
      "id": "swissnames3d-places",
      "type": "symbol",
      "source": "swissnames3d",
      "source-layer": "place",
      "minzoom": 8,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Frutiger Neue Condensed Regular"]
      },
      "paint": {
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "swissnames3d-peaks",
      "type": "symbol",
      "source": "swissnames3d",
      "source-layer": "mountain_peak",
      "minzoom": 11,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Frutiger Neue Italic"]
      },
      "paint": {
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "swissnames3d-lakes",
      "type": "symbol",
      "source": "swissnames3d",
      "source-layer": "water_name",
      "minzoom": 9,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Frutiger Neue Italic"]
      },
      "paint": {
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
